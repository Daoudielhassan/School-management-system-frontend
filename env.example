# ===================================
# DEVELOPMENT (Local microservices)
# ===================================
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:9000

# ===================================
# PRODUCTION (Docker deployment)
# ===================================
# NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# ===================================
# FEATURE FLAGS
# ===================================
NEXT_PUBLIC_USE_API_GATEWAY=true
NEXT_PUBLIC_ENABLE_SERVICE_RETRY=true
NEXT_PUBLIC_ENABLE_CIRCUIT_BREAKER=false
NEXT_PUBLIC_ENABLE_API_LOGGING=true

# ===================================
# DIRECT SERVICE URLS (Development/Testing)
# ===================================
NEXT_PUBLIC_IDENTITY_SERVICE_URL=http://localhost:8084
NEXT_PUBLIC_ACADEMIC_YEAR_SERVICE_URL=http://localhost:8085
NEXT_PUBLIC_STUDENT_SERVICE_URL=http://localhost:8086
NEXT_PUBLIC_ACADEMIC_STRUCTURE_URL=http://localhost:8087
NEXT_PUBLIC_INSTRUCTOR_SERVICE_URL=http://localhost:8088
NEXT_PUBLIC_ATTENDANCE_SERVICE_URL=http://localhost:8090
NEXT_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:8091
NEXT_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:8092
NEXT_PUBLIC_REPORT_SERVICE_URL=http://localhost:8093
NEXT_PUBLIC_ADMIN_SERVICE_URL=http://localhost:8094
NEXT_PUBLIC_MANAGER_SERVICE_URL=http://localhost:8095
